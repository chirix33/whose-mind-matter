@@ -0,0 +1,54 @@
+"""Hybrid block (D-019): actual-tokenizer forecast for the fallback prompts (CPU; run with the vLLM venv, offline).
+
+    HF_HUB_OFFLINE=1 ~/venvs/vllm/bin/python scripts/hybrid_token_forecast.py
+
+Tokenizes the rendered t0 prompts (reports/hybrid-block/rendered-t0.json) with the served model's own tokenizer and chat
+template, and combines them with MEASURED per-decision usage of the direct policy from the repair-block traces.
+"""
+
+import json
+import os
+import statistics
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+REPAIR = Path.home() / "officeminds-runs" / "repair" / "repair-stage2-20261029-132459-743ace" / "episodes.jsonl"
+
+
+def main():
+    from transformers import AutoTokenizer
+    tok = AutoTokenizer.from_pretrained("openai/gpt-oss-20b")
+    rendered = json.loads((ROOT / "reports" / "hybrid-block" / "rendered-t0.json").read_text())
+    n = lambda msgs: len(tok(tok.apply_chat_template(msgs, add_generation_prompt=True, tokenize=False),  # noqa: E731
+                             add_special_tokens=False)["input_ids"])
+    per = []
+    for r in rendered:
+        row = {"construction": r["construction"], "decision": n(r["decision"])}
+        if "check" in r:
+            row["check"] = n(r["check"])
+            row["redecision"] = n(r["redecision"])
+        per.append(row)
+    measured = {"decision_prompt": [], "decision_completion": [], "decisions_per_episode": []}
+    for line in REPAIR.read_text().splitlines():
+        e = json.loads(line)
+        if e.get("condition") != "none":
+            continue
+        ds = [c for c in e["calls"] if c["kind"] == "decision"]
+        measured["decisions_per_episode"].append(len(ds))
+        for c in ds:
+            for a in c["attempts"]:
+                measured["decision_prompt"].append(a["prompt_tokens"])
+                measured["decision_completion"].append(a["completion_tokens"])
+    m = {k: round(statistics.mean(v), 1) for k, v in measured.items()}
+    out = {"tokenizer": "openai/gpt-oss-20b (HF snapshot, chat template)", "t0_rendered": per,
+           "measured_direct_none_repair_stage2": m,
+           "t0_template_vs_server_note": "server prompt_tokens for the same t0 prompt can differ slightly from the local "
+                                         "chat-template count (server-side system/developer header)."}
+    (ROOT / "reports" / "hybrid-block" / "token-forecast.json").write_bytes(json.dumps(out, indent=1).encode())
+    print(json.dumps(out, indent=1))
+
+
+if __name__ == "__main__":
+    os.environ.setdefault("HF_HUB_OFFLINE", "1")
+    main()
diff --git a/scripts/hybrid_trigger_audit.py b/scripts/hybrid_trigger_audit.py
new file mode 100644
index 0000000..f63674c
--- /dev/null
+++ b/scripts/hybrid_trigger_audit.py
@@ -0,0 +1,171 @@
+"""Hybrid block (D-019) fallback step 1: CPU-only trigger-coverage audit on EXISTING no-note traces.
+
+Input: the repair-block Stage 2 run (D-015), condition "none" (direct full-history policy, no notes), 24 dev-v3 seeds
+(20261100-23, already inspected development data) x 12 constructions x stakes x1/x4 x 2 draws = 1,152 episodes.
+
+For every recorded irreversible commitment (give / drop) the deployed checker is applied counterfactually at that
+history: the public-model posterior (world enumeration under the disclosed model, robot-visible history only) gives
+p_success and the recipient-location distribution; the shared gate compares J_commit with the declared search
+alternative. Evaluation-only quantities (Bayes value V*(h), realized outcome) are labelled as such.
+
+The "ideal continuation" column replaces a vetoed recorded commitment by V*(h_t): an OPTIMISTIC diagnostic, not a
+deployable effect and not a ceiling for every gate.
+
+    python3 scripts/hybrid_trigger_audit.py [episodes.jsonl]
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from officeminds import devgen3 as G  # noqa: E402
+from officeminds.episode import VisibleHistory  # noqa: E402
+from officeminds.world import Action, legal_actions  # noqa: E402
+from vomi.oracle import ExactOracle  # noqa: E402
+from vomi.relational import gate  # noqa: E402
+
+RUN = Path(os.environ.get("OFFICEMINDS_RUNS", Path.home() / "officeminds-runs")) / "repair" / \
+    "repair-stage2-20261029-132459-743ace" / "episodes.jsonl"
+OUT = ROOT / "reports" / "hybrid-block"
+
+
+def parse(s: str) -> Action:
+    m = re.match(r"(\w+)\((\w*)(?:,(\w+))?\)", s)
+    return Action(m[1], m[2] or "", m[3] or "")
+
+
+def is_commit(a: Action) -> bool:
+    return a.kind in ("give", "drop")
+
+
+def commit_class(construction: str, a: Action) -> str:
+    if a.kind == "give":
+        return "social_belief"
+    return "testimony_reliability" if construction in ("4b", "4c") else "physical"
+
+
+def excluded_offices(hist: VisibleHistory, cfg) -> tuple:
+    """Offices the robot has entered after the prologue without seeing the recipient (nobody moves afterwards)."""
+    return tuple(sorted({o.room for _, o in hist.steps[1:] if o.room in cfg.offices
+                         and cfg.recipient not in o.people_present}))
+
+
+def checker(o: ExactOracle, cfg, a: Action) -> tuple[float, dict]:
+    """Deployed checker: public-model posterior from the visible history only (no hidden values)."""
+    loc = {}
+    p = 0.0
+    for w, x in o.belief:
+        r = x.people_rooms[cfg.recipient]
+        loc[r] = loc.get(r, 0.0) + w
+        if a.kind == "give":
+            other, fact = cfg.handoff_routes[a.target]
+            m = x.minds[a.target]
+            dest = m.beliefs.get(fact, "unknown") if not other else m.nested.get((other, fact), "unknown")
+            p += w * (dest == r)
+        elif a.kind == "drop":
+            p += w * (a.target == r)
+    return p, loc
+
+
+def audit(path: Path) -> dict:
+    eps = [json.loads(l) for l in path.read_text().splitlines() if l.strip()]
+    eps = [e for e in eps if e.get("condition") == "none" and "blocked" not in e]
+    insts = {}
+    for seed in sorted({e["seed"] for e in eps}):
+        for inst in G.generate(seed):
+            insts[(seed, inst.instance_id)] = inst
+    rows = []
+    for e in eps:
+        inst = insts[(e["seed"], e["instance_id"])]
+        sc, cfg = inst.scenario, inst.scenario.config
+        w = sc.build(inst.hidden)  # evaluation replay (privileged world; the checker below sees only `h`)
+        h = VisibleHistory(sc.brief, [(None, w.reset())])
+        o0 = ExactOracle(sc, h)
+        v0 = o0.value(o0.belief, h.last)
+        rewards, commits = 0.0, []
+        for k, s in enumerate(e["actions"]):
+            a = parse(s)
+            assert a in legal_actions(cfg, h.last), (e["state_id"], s)
+            if is_commit(a):
+                o = ExactOracle(sc, h)
+                p, loc = checker(o, cfg, a)
+                v = gate(s, p, loc, h.last.room, cfg.horizon - h.last.t, cfg, excluded_offices(h, cfg), "public_model")
+                vstar = o.value(o.belief, h.last)  # EVALUATION ONLY
+                best = str(o.best_action(o.belief, h.last))  # EVALUATION ONLY
+            obs = w.step(a)
+            h.steps.append((a, obs))
+            if is_commit(a):
+                commits.append({"step": k, "action": s, "class": commit_class(inst.construction, a), "p": round(p, 6),
+                                "J": round(v.j_commit, 6), "V_alt": round(v.v_alt, 6), "allow": v.allow,
+                                "outcome": obs.outcome, "rewards_before": round(rewards, 6), "vstar": round(vstar, 6),
+                                "bayes_action": best})
+            rewards += obs.reward
+        assert abs(rewards - e["return_"]) < 1e-9, e["state_id"]
+        first_veto = next((c for c in commits if not c["allow"]), None)
+        ideal = first_veto["rewards_before"] + first_veto["vstar"] if first_veto else rewards
+        o_first = str(o0.best_action(o0.belief, VisibleHistory(sc.brief, [(None, sc.build(inst.hidden).reset())]).last))
+        rows.append({"state_id": e["state_id"], "seed": e["seed"], "construction": inst.construction,
+                     "stakes": inst.variant.stakes, "replicate": e["replicate"], "return": round(rewards, 6),
+                     "outcome": e["outcome"], "v0_bayes": round(v0, 6), "bayes_first": o_first, "commits": commits,
+                     "ideal_after_veto": round(ideal, 6), "actions": e["actions"]})
+    return summarize(rows), rows
+
+
+def summarize(rows: list) -> dict:
+    def agg(rs):
+        n = len(rs)
+        cs = [c for r in rs for c in r["commits"]]
+        wrong = [c for c in cs if c["outcome"] == "error"]
+        right = [c for c in cs if c["outcome"] == "success"]
+        missed = [r for r in rs if not r["commits"] and re.match(r"(give|drop)", r["bayes_first"])]
+        return {
+            "episodes": n,
+            "mean_return": round(sum(r["return"] for r in rs) / n, 4),
+            "mean_bayes_v0": round(sum(r["v0_bayes"] for r in rs) / n, 4),
+            "mean_lost_vs_bayes": round(sum(r["v0_bayes"] - r["return"] for r in rs) / n, 4),
+            "lost_in_error_episodes": round(sum(r["v0_bayes"] - r["return"] for r in rs if r["outcome"] == "error") / n, 4),
+            "lost_in_timeouts": round(sum(r["v0_bayes"] - r["return"] for r in rs if r["outcome"] == "timeout") / n, 4),
+            "lost_in_successes": round(sum(r["v0_bayes"] - r["return"] for r in rs if r["outcome"] == "success") / n, 4),
+            "error_rate": round(sum(r["outcome"] == "error" for r in rs) / n, 4),
+            "timeout_rate": round(sum(r["outcome"] == "timeout" for r in rs) / n, 4),
+            "commit_triggers": len(cs),
+            "wrong_commits": len(wrong), "right_commits": len(right),
+            "veto_of_wrong": sum(not c["allow"] for c in wrong), "veto_of_right": sum(not c["allow"] for c in right),
+            "allowed_wrong": sum(c["allow"] for c in wrong),
+            "episodes_with_veto": sum(any(not c["allow"] for c in r["commits"]) for r in rs),
+            "optimistic_gain_ideal_after_veto": round(sum(r["ideal_after_veto"] - r["return"] for r in rs) / n, 4),
+            "missed_commit_opportunity_episodes": len(missed),
+            "lost_in_missed_opportunity": round(sum(r["v0_bayes"] - r["return"] for r in missed) / n, 4),
+            "by_class": {k: {"triggers": sum(c["class"] == k for c in cs),
+                             "wrong": sum(c["class"] == k for c in wrong),
+                             "veto_wrong": sum(c["class"] == k and not c["allow"] for c in wrong),
+                             "veto_right": sum(c["class"] == k and not c["allow"] for c in right)}
+                         for k in ("social_belief", "physical", "testimony_reliability")},
+        }
+    out = {"all": agg(rows)}
+    for c in sorted({r["construction"] for r in rows}):
+        for st in (1.0, 4.0):
+            rs = [r for r in rows if r["construction"] == c and r["stakes"] == st]
+            out[f"{c}-x{st:g}"] = agg(rs)
+    return out
+
+
+def main():
+    path = Path(sys.argv[1]) if len(sys.argv) > 1 else RUN
+    summary, rows = audit(path)
+    OUT.mkdir(parents=True, exist_ok=True)
+    res = {"source": str(path), "condition": "none", "summary": summary}
+    (OUT / "trigger-audit.json").write_bytes(json.dumps(res, indent=1).encode("utf-8"))
+    (OUT / "trigger-audit-rows.jsonl").write_bytes("".join(json.dumps(r) + "\n" for r in rows).encode("utf-8"))
+    print(json.dumps(summary["all"], indent=1))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/report_hybrid_fallback.py b/scripts/report_hybrid_fallback.py
new file mode 100644
index 0000000..8a5b733
--- /dev/null
+++ b/scripts/report_hybrid_fallback.py
@@ -0,0 +1,201 @@
+"""Hybrid block (D-019) fallback analysis, pre-declared in reports/hybrid-block/fallback-protocol.md.
+
+    python3 scripts/report_hybrid_fallback.py RUN_DIR     # writes reports/hybrid-block/fallback-results.{json,md}
+"""
+
+from __future__ import annotations
+
+import json
+import random
+import re
+import statistics
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "src"))
+
+from officeminds import devgen3 as G  # noqa: E402
+from officeminds.world import Action  # noqa: E402
+
+OUT = ROOT / "reports" / "hybrid-block"
+CONDS = ("direct", "checker_gate", "generic_gate", "ask_first")
+B = 10_000
+
+
+def parse(s: str) -> Action:
+    m = re.match(r"(\w+)\((\w*)(?:,(\w+))?\)", s)
+    return Action(m[1], m[2] or "", m[3] or "")
+
+
+def tokens(e) -> int:
+    return sum(u["prompt_tokens"] + u["completion_tokens"] for u in e["usage"].values())
+
+
+def calls(e) -> int:
+    return sum(u["attempts"] for u in e["usage"].values())
+
+
+def commit_class(con: str, a: Action) -> str:
+    return "social_belief" if a.kind == "give" else ("testimony_reliability" if con in ("4b", "4c") else "physical")
+
+
+def unit_means(eps, key):
+    units = {}
+    for e in eps:
+        units.setdefault((e["base"], e["condition"]), []).append(key(e))
+    return {k: statistics.mean(v) for k, v in units.items()}
+
+
+def paired(eps, a, b, key):
+    """Per-base-scenario paired difference a - b with a construction-stratified bootstrap CI."""
+    m = unit_means(eps, key)
+    bases = sorted({e["base"] for e in eps if (e["base"], a) in m and (e["base"], b) in m})
+    d = {u: m[(u, a)] - m[(u, b)] for u in bases}
+    strata = {}
+    for u in bases:
+        strata.setdefault(u.split("-", 1)[1], []).append(u)
+    rng = random.Random(0)
+    boots = []
+    for _ in range(B):
+        s = [d[rng.choice(us)] for us in strata.values() for _ in us]
+        boots.append(statistics.mean(s))
+    boots.sort()
+    return {"mean": round(statistics.mean(d.values()), 4), "ci95": [round(boots[int(0.025 * B)], 4),
+                                                                  round(boots[int(0.975 * B) - 1], 4)],
+            "units": len(bases)}
+
+
+def replay_vetoes(eps):
+    """EVALUATION ONLY: would each vetoed proposal have failed? (replay with the hidden draw)."""
+    insts = {}
+    for seed in sorted({e["seed"] for e in eps}):
+        for inst in G.generate(seed):
+            insts[f"s{seed}-{inst.instance_id}"] = inst
+    out = []
+    for e in eps:
+        if e["condition"] not in ("checker_gate", "generic_gate", "ask_first"):
+            continue
+        inst = insts[e["state_id"]]
+        w = inst.scenario.build(tuple(tuple(x) for x in e["privileged"]["hidden"]))
+        w.reset()
+        for k, log in enumerate(e["steps"]):
+            prop = parse(log["proposal"])
+            if log.get("veto") or log.get("substituted_ask"):
+                c = w.clone()
+                o = c.step(prop)
+                out.append({"condition": e["condition"], "construction": e["construction"], "stakes": e["stakes"],
+                            "class": commit_class(e["construction"], prop), "would_have": o.outcome,
+                            "redecision": log.get("redecision"), "executed": log["executed"],
+                            "scripted": "scripted_fallback" in log, "p": (log.get("check") or {}).get("p")})
+            w.step(parse(log["executed"]))
+    return out
+
+
+def summarize(eps):
+    res = {"per_condition": {}, "paired": {}, "criteria": {}}
+    for c in CONDS:
+        es = [e for e in eps if e["condition"] == c]
+        n = len(es)
+        steps = [s for e in es for s in e["steps"]]
+        res["per_condition"][c] = {
+            "episodes": n,
+            "mean_return": round(statistics.mean(e["return_"] for e in es), 4),
+            "success": round(sum(e["outcome"] == "success" for e in es) / n, 4),
+            "error": round(sum(e["outcome"] == "error" for e in es) / n, 4),
+            "timeout": round(sum(e["outcome"] == "timeout" for e in es) / n, 4),
+            "mean_steps": round(statistics.mean(e["n_steps"] for e in es), 3),
+            "mean_processed_tokens": round(statistics.mean(tokens(e) for e in es), 1),
+            "mean_prompt_tokens": round(statistics.mean(sum(u["prompt_tokens"] for u in e["usage"].values()) for e in es), 1),
+            "mean_completion_tokens": round(statistics.mean(sum(u["completion_tokens"] for u in e["usage"].values())
+                                                            for e in es), 1),
+            "mean_call_attempts": round(statistics.mean(calls(e) for e in es), 3),
+            "calls_by_kind": {k: sum(e["usage"].get(k, {}).get("calls", 0) for e in es) for k in ("decision", "redecision", "check")},
+            "failed_attempts": sum(u["attempts_failed"] for e in es for u in e["usage"].values()),
+            "call_fallbacks": sum(u["fallbacks"] for e in es for u in e["usage"].values()),
+            "mean_call_latency_s": round(statistics.mean(sum(u["latency_s"] for u in e["usage"].values()) for e in es), 3),
+            "mean_wall_clock_s": round(statistics.mean(e["wall_clock_s"] for e in es), 3),
+            "checker_cpu_ms_total": round(sum(e["checker_cpu_s"] for e in es) * 1000, 1),
+            "triggers": sum(1 for s in steps if re.match(r"(give|drop)\(", s["proposal"])),
+            "vetoes": sum(bool(s.get("veto")) for s in steps),
+            "scripted_fallbacks": sum("scripted_fallback" in s for s in steps),
+            "cache_hits": sum(bool((s.get("check") or {}).get("cache_hit")) for s in steps),
+            "cap_hits": sum(bool((s.get("check") or {}).get("cap_reached")) for s in steps),
+            "check_failures": sum(bool((s.get("check") or {}).get("failed")) for s in steps),
+            "substituted_asks": sum("substituted_ask" in s for s in steps),
+            "correct_commit_rate": round(sum(e["outcome"] == "success" and re.match(r"(give|drop)\(", e["actions"][-1] or "")
+                                             is not None for e in es) / n, 4),
+        }
+    ret = lambda e: e["return_"]  # noqa: E731
+    for a, b in (("checker_gate", "direct"), ("generic_gate", "direct"), ("ask_first", "direct"),
+                 ("checker_gate", "generic_gate"), ("checker_gate", "ask_first"), ("generic_gate", "ask_first")):
+        res["paired"][f"{a}-{b}"] = {"return": paired(eps, a, b, ret)}
+    pc = res["per_condition"]
+    prim = res["paired"]["checker_gate-direct"]["return"]
+    crit_a = prim["mean"] >= 0.05
+    crit_b = {}
+    for comp in ("generic_gate", "ask_first"):
+        d = res["paired"][f"checker_gate-{comp}"]["return"]
+        ratio = pc["checker_gate"]["mean_processed_tokens"] / pc[comp]["mean_processed_tokens"]
+        quality = d["mean"] >= 0.03 and ratio <= 1.10
+        efficiency = ratio <= 0.80 and d["mean"] >= 0 and d["ci95"][0] > -0.05
+        crit_b[comp] = {"delta_return": d, "token_ratio": round(ratio, 3), "quality_route": quality,
+                        "efficiency_route": efficiency, "pass": quality or efficiency}
+    crit_c = pc["checker_gate"]["success"] >= pc["direct"]["success"] - 0.05
+    gd = res["paired"]["checker_gate-generic_gate"]["return"]
+    res["criteria"] = {"a_gain_vs_direct": {"value": prim, "pass": crit_a},
+                       "b_vs_comparators": crit_b,
+                       "c_not_only_suppression": {"checker_success": pc["checker_gate"]["success"],
+                                                  "direct_success": pc["direct"]["success"], "pass": crit_c},
+                       "continue_concept2": crit_a and all(x["pass"] for x in crit_b.values()) and crit_c,
+                       "generic_similar": abs(gd["mean"]) < 0.03 and gd["ci95"][0] <= 0 <= gd["ci95"][1]}
+    # descriptive breakdowns
+    res["by_construction"] = {}
+    for con in sorted({e["construction"] for e in eps}):
+        res["by_construction"][con] = {c: {"return": round(statistics.mean(e["return_"] for e in eps if e["construction"] == con
+                                                                           and e["condition"] == c), 3),
+                                           "error": round(statistics.mean(e["outcome"] == "error" for e in eps
+                                                                          if e["construction"] == con and e["condition"] == c), 3)}
+                                       for c in CONDS}
+    res["by_stakes"] = {f"x{st:g}": {c: round(statistics.mean(e["return_"] for e in eps if e["stakes"] == st
+                                                              and e["condition"] == c), 4) for c in CONDS}
+                        for st in (1.0, 4.0)}
+    return res
+
+
+def interventions(rows):
+    out = {}
+    for c in ("checker_gate", "generic_gate", "ask_first"):
+        rs = [r for r in rows if r["condition"] == c]
+        out[c] = {"n": len(rs),
+                  "would_have_failed": sum(r["would_have"] == "error" for r in rs),
+                  "would_have_succeeded": sum(r["would_have"] == "success" for r in rs),
+                  "by_class": {k: {"n": sum(r["class"] == k for r in rs),
+                                   "would_fail": sum(r["class"] == k and r["would_have"] == "error" for r in rs),
+                                   "would_succeed": sum(r["class"] == k and r["would_have"] == "success" for r in rs)}
+                               for k in ("social_belief", "physical", "testimony_reliability")}}
+    return out
+
+
+def main():
+    run = Path(sys.argv[1])
+    raw = [json.loads(l) for l in (run / "episodes.jsonl").read_text().splitlines() if l.strip()]
+    blocked = [e for e in raw if "blocked" in e]
+    eps = [e for e in raw if "blocked" not in e]
+    res = summarize(eps)
+    rows = replay_vetoes(eps)
+    res["interventions"] = interventions(rows)
+    res["blocked_episodes"] = len(blocked)
+    res["episodes"] = len(eps)
+    res["seeds"] = sorted({e["seed"] for e in eps})
+    res["run_dir"] = str(run)
+    man = run / "manifest.json"
+    if man.exists():
+        res["manifest"] = json.loads(man.read_text())
+    (OUT / "fallback-results.json").write_bytes(json.dumps(res, indent=1, default=str).encode("utf-8"))
+    (OUT / "fallback-interventions.jsonl").write_bytes("".join(json.dumps(r) + "\n" for r in rows).encode("utf-8"))
+    print(json.dumps({k: res[k] for k in ("per_condition", "paired", "criteria", "interventions", "by_stakes")}, indent=1))
+
+
+if __name__ == "__main__":
+    main()
