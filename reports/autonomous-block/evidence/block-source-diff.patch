+# ----------------------------------------------------------------------------- scoring v3 (autonomous block Round 1)
+# Changes from v2 (each output gets exactly ONE category; the categories partition n):
+#   invalid           no valid output after the failure protocol
+#   abstained         status insufficient_evidence (v2) or abstain (v2.1): coverage loss. Its distribution still
+#                     enters the proper scores, which are reported both over all valid outputs and over attributed ones
+#   ambiguous_reference  the context's reference is flagged ambiguous by the reference audit (undisclosed generator
+#                     base rates or template structure) AND the top value has posterior < SUPPORT_MIN: reported apart,
+#                     never counted as a model error
+#   correct_supported / correct_unsupported / incorrect_supported / leakage   as in v2
+#   unsupported_committed  wrong, posterior(top) < SUPPORT_MIN, and top_p >= COMMIT_P: asserted unsupported content
+#   unsupported_hedged     wrong, posterior(top) < SUPPORT_MIN, but top_p < COMMIT_P: an uncertain miss, not an
+#                     assertion; it is not counted as hallucination-type content
+# "uncertain" (v2.1) is an attributed status: a broad distribution is scored, not treated as abstention.
+COMMIT_P = 0.5
+ABSTAIN = ("insufficient_evidence", "abstain")
+CATS_V3 = ("correct_supported", "supported_spread", "correct_unsupported", "incorrect_supported", "leakage",
+           "unsupported_committed", "unsupported_hedged", "ambiguous_reference", "abstained", "invalid")
+
+
+def score_output_v3(parsed: dict | None, truth: str, posterior: dict[str, float], known: set[str], values: list[str],
+                    reference_ambiguous: bool = False) -> dict:
+    if parsed is None:
+        return {"valid": False, "category": "invalid"}
+    s = score_output(parsed, truth, posterior, known, values)
+    s["abstained"] = parsed.get("status") in ABSTAIN
+    dist = {}
+    for h in parsed.get("hypotheses", []):
+        dist[h["value"]] = dist.get(h["value"], 0.0) + float(h["p"])
+    # v3.1 tie rule (found after inspecting Round 1 local outputs; applies to every row): when several values share
+    # the top mass, the category must not depend on list order. A supported tied value is preferred over an
+    # unsupported one; among supported tied values the truth (if present) gives `supported_spread` (an honest split
+    # that includes the realized state), never a top-1 hit.
+    tied = sorted(v for v, p in dist.items() if abs(p - s["top_p"]) <= 1e-9)
+    tied_sup = [v for v in tied if posterior.get(v, 0.0) >= SUPPORT_MIN]
+    if len(tied) > 1:
+        # all tied values unsupported: prefer a robot-known value when the truth is "unknown" (leakage over committed,
+        # independent of alphabetical order; Round 1 Opus gate, optional item)
+        leak = [v for v in tied if truth == "unknown" and v != "unknown" and v in known]
+        s["top"] = truth if truth in tied_sup else (tied_sup[0] if tied_sup else
+                                                    (truth if truth in tied else (leak[0] if leak else tied[0])))
+    s["tied_top"] = tied if len(tied) > 1 else None
+    post_top = posterior.get(s["top"], 0.0)
+
+    def content_category() -> str:
+        if s["top"] == truth:
+            return ("supported_spread" if len(tied) > 1 else "correct_supported") if post_top >= SUPPORT_MIN else "correct_unsupported"
+        if post_top >= SUPPORT_MIN:
+            return "incorrect_supported"
+        if reference_ambiguous:
+            return "ambiguous_reference"
+        if truth == "unknown" and s["top"] != "unknown" and s["top"] in known:
+            return "leakage"
+        return "unsupported_committed" if s["top_p"] >= COMMIT_P else "unsupported_hedged"
+
+    # status-agnostic content category for EVERY valid output (Round 1 Opus gate item 3): pilot-v2's
+    # insufficient_evidence covers what v2.1 calls uncertain, so package comparisons must not hide content in abstentions
+    s["content_category"] = content_category()
+    s["category"] = "abstained" if s["abstained"] else s["content_category"]
+    s["status"] = parsed.get("status")
+    # mass on values the reference gives < SUPPORT_MIN (Opus gate item 4): complements the top-p commit line
+    s["unsupported_mass"] = sum(p for v, p in dist.items() if posterior.get(v, 0.0) < SUPPORT_MIN)
+    s["tv_posterior"] = 0.5 * sum(abs(dist.get(c, 0.0) - posterior.get(c, 0.0)) for c in set(dist) | set(posterior))
+    return s
